# ---------------------------------------------------------------------------
# btc-trader configuration — PLACEHOLDERS ONLY.
# Copy to `.env` and edit. `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console            # console | json  (use json in deployed environments)

# --- Trading mode ----------------------------------------------------------
# data_only : collect + visualise market data only (no strategy, no trades)
# paper     : run the strategy, simulate trades (no exchange orders)
# live      : the worker places REAL bitFlyer orders (see "Live trading" below)
TRADING_MODE=data_only

# --- Exchange --------------------------------------------------------------
EXCHANGE=bitflyer
PRODUCT_CODE=BTC_JPY
BITFLYER_PUBLIC_BASE_URL=https://api.bitflyer.com
BITFLYER_TIMEOUT_SECONDS=10.0
BITFLYER_MAX_RETRIES=4
# Public API budget (bitFlyer documents ~500 requests / 5 min per IP).
BITFLYER_RATE_LIMIT_REQUESTS=400
BITFLYER_RATE_LIMIT_WINDOW_SECONDS=300

# Credentials: leave EMPTY unless live trading. Create a key with trade and
# read permissions only (no withdrawal). Never commit real values.
BITFLYER_API_KEY=
BITFLYER_API_SECRET=

# --- Market data collection ------------------------------------------------
MARKET_DATA_INTERVAL_SECONDS=300

# --- Database --------------------------------------------------------------
# Credentials for the `db` container. docker-compose.yml builds DATABASE_URL from
# these, so change the password here (not in DATABASE_URL) for a Docker deploy.
# Use letters and digits only: the password is embedded in a URL, where
# characters such as @ : / # ? % break it. Example: `openssl rand -hex 24`.
POSTGRES_USER=btc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=btc_trader
POSTGRES_PORT=5432

# Local default: SQLite. Docker Compose overrides this with its PostgreSQL URL.
DATABASE_URL=sqlite+aiosqlite:///./data/btc_trader.db
DB_ECHO=false

# --- Strategy ---------------------------------------------------------------
# none | trend_ensemble. The trend ensemble trades daily bars: see
# docs/strategy_research.md for why short-horizon rules were retired.
STRATEGY_NAME=none
STRATEGY_TREND_HORIZONS=5,10,20,30,60,90,150,250,360
STRATEGY_VOLATILITY_WINDOW_DAYS=90
STRATEGY_TARGET_ANNUAL_VOLATILITY_PERCENT=25
STRATEGY_MAX_EXPOSURE_PERCENT=100
STRATEGY_REBALANCE_BAND_PERCENT=20
STRATEGY_MAX_DAILY_BAR_AGE_DAYS=2

# --- Daily history ------------------------------------------------------------
# bitFlyer has no public candle endpoint, so a year+ of daily closes is
# bootstrapped from bitbank's public BTC/JPY candles (no credentials). Set to
# `none` to rely only on this platform's own collected ticks.
DAILY_HISTORY_PROVIDER=bitbank
DAILY_HISTORY_BASE_URL=https://public.bitbank.cc
DAILY_HISTORY_PAIR=btc_jpy
DAILY_HISTORY_YEARS=5
DAILY_HISTORY_AUTO_SYNC=true

# --- Profitability ---------------------------------------------------------
# bitFlyer Lightning spot: 0.15% for accounts under ¥100k 30-day volume.
MIN_PROFIT_PERCENT=1.0
TAKER_FEE_PERCENT=0.15
ESTIMATED_SLIPPAGE_BPS=5
PAPER_SLIPPAGE_BPS=5
PAPER_INITIAL_JPY=1000000

# --- Exchange lot constraints ----------------------------------------------
MIN_ORDER_SIZE_BTC=0.001
ORDER_SIZE_STEP_BTC=0.00000001
MIN_ORDER_NOTIONAL_JPY=0
ENFORCE_EXCHANGE_MINIMUMS=true

# --- Risk limits -----------------------------------------------------------
MAX_POSITION_JPY=500000
MAX_ORDER_JPY=300000
MAX_DAILY_LOSS_JPY=30000
MAX_MARKET_DATA_AGE_SECONDS=600
RISK_DAY_TIMEZONE=Asia/Tokyo

# --- Trading safety switches (all must be flipped for live trading) --------
ENABLE_AUTOMATIC_TRADING=false
LIVE_TRADING_ACKNOWLEDGED=false
TRADING_KILL_SWITCH=false

# --- Live trading ------------------------------------------------------------
# JPY the bot may manage; 0 blocks live orders. JPY above it is never spent,
# but ALL BTC in the account counts as the bot's - keep other BTC elsewhere.
LIVE_CAPITAL_JPY=0
# Live orders are limit IOC priced this far through the touch (0.30%).
LIVE_MAX_SLIPPAGE_BPS=30
LIVE_ORDER_POLL_SECONDS=20
# Failed/rejected orders within 24h that pause live trading.
LIVE_MAX_FAILED_ORDERS_PER_DAY=3

# --- Alerts ------------------------------------------------------------------
# Slack or Discord incoming-webhook URL for fills, failures and halts.
ALERT_WEBHOOK_URL=

# --- API / dashboard -------------------------------------------------------
# Host address Docker publishes the API and dashboard on. Keep 127.0.0.1 and
# use an SSH tunnel or VPN: neither service has authentication, and the
# dashboard can change trading settings. Docker bypasses ufw/firewalld.
BIND_ADDRESS=127.0.0.1
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://api:8000
DASHBOARD_PORT=8501
DASHBOARD_REFRESH_SECONDS=300
DASHBOARD_TIMEZONE=Asia/Tokyo

# --- Scheduler -------------------------------------------------------------
RUN_SCHEDULER_IN_API=false        # true = single-container deployment
PORTFOLIO_SNAPSHOT_INTERVAL_SECONDS=900
