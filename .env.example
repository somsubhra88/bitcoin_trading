# ---------------------------------------------------------------------------
# btc-trader configuration — PLACEHOLDERS ONLY.
# Copy to `.env` and edit. `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console            # console | json  (use json in deployed environments)

# --- Trading mode ----------------------------------------------------------
# data_only : collect + visualise market data only (no strategy, no trades)
# paper     : run strategies, simulate trades (no exchange orders)
# live      : reserved for future live execution; adapter currently refuses orders
TRADING_MODE=data_only

# --- Exchange --------------------------------------------------------------
EXCHANGE=bitflyer
PRODUCT_CODE=BTC_JPY
BITFLYER_PUBLIC_BASE_URL=https://api.bitflyer.com
BITFLYER_TIMEOUT_SECONDS=10.0
BITFLYER_MAX_RETRIES=4
# Public API budget (bitFlyer documents ~500 requests / 5 min per IP).
BITFLYER_RATE_LIMIT_REQUESTS=400
BITFLYER_RATE_LIMIT_WINDOW_SECONDS=300

# Credentials: leave EMPTY unless private API access is required.
# Never commit real values. Prefer Docker secrets / env injection in production.
BITFLYER_API_KEY=
BITFLYER_API_SECRET=

# --- Market data collection ------------------------------------------------
MARKET_DATA_INTERVAL_SECONDS=300
COLLECT_ORDER_BOOK=true
COLLECT_EXECUTIONS=true
EXECUTIONS_FETCH_LIMIT=100
ORDER_BOOK_DEPTH_LEVELS=10

# --- Database --------------------------------------------------------------
# Credentials for the `db` container. docker-compose.yml builds DATABASE_URL from
# these, so change the password here (not in DATABASE_URL) for a Docker deploy.
POSTGRES_USER=btc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=btc_trader
POSTGRES_PORT=5432

# Local default: SQLite. Docker Compose overrides this with its PostgreSQL URL.
DATABASE_URL=sqlite+aiosqlite:///./data/btc_trader.db
DB_ECHO=false

# --- Strategy ---------------------------------------------------------------
STRATEGY_NAME=none
STRATEGY_FAST_WINDOW=8
STRATEGY_SLOW_WINDOW=21
STRATEGY_MEAN_REVERSION_WINDOW=20
STRATEGY_MOMENTUM_WINDOW=12
STRATEGY_VOLATILITY_WINDOW=20
STRATEGY_EMA_THRESHOLD_PERCENT=0.05
STRATEGY_MEAN_REVERSION_ZSCORE_THRESHOLD=1.0
STRATEGY_MOMENTUM_THRESHOLD_PERCENT=0.01
STRATEGY_RISK_FRACTION=0.25
STRATEGY_TARGET_VOLATILITY_PERCENT=2.0
STRATEGY_EDGE_MULTIPLE=1.5
STRATEGY_REGIME_FILTER=true
STRATEGY_DEEPLOB_WINDOW=32
STRATEGY_DEEPLOB_HORIZON=3
STRATEGY_DEEPLOB_TRAINING_WINDOW=256
STRATEGY_DEEPLOB_LEVELS=10
STRATEGY_DEEPLOB_THRESHOLD_PERCENT=0.01
STRATEGY_DEEPLOB_MIN_QUALITY_PERCENT=80
STRATEGY_DEEPLOB_RIDGE_LAMBDA=0
STRATEGY_ORDER_FLOW_WINDOW=20
STRATEGY_ORDER_FLOW_THRESHOLD=0.25
STRATEGY_BREAKOUT_WINDOW=24
STRATEGY_MICROPRICE_THRESHOLD_BPS=1.5

# --- Profitability ---------------------------------------------------------
MIN_PROFIT_PERCENT=1.0
TAKER_FEE_PERCENT=0.15
MAKER_FEE_PERCENT=0.15
ESTIMATED_SLIPPAGE_BPS=5
PAPER_SLIPPAGE_BPS=5
PAPER_INITIAL_JPY=1000000
PAPER_MIN_CONFIDENCE=0.35
PAPER_TRAILING_STOP_PERCENT=0.8
PAPER_STOP_LOSS_PERCENT=1.5
PAPER_COOLDOWN_BARS=1
PAPER_MAX_HOLDING_BARS=0

# --- Execution model and exchange lot constraints --------------------------
EXECUTION_STYLE=taker             # taker | maker
MAKER_TIMEOUT_BARS=2
MIN_ORDER_SIZE_BTC=0.001
ORDER_SIZE_STEP_BTC=0.00000001
PRICE_TICK_JPY=1
MIN_ORDER_NOTIONAL_JPY=0
ENFORCE_EXCHANGE_MINIMUMS=true

# --- Optional adaptive strategy ensemble -----------------------------------
ENABLE_STRATEGY_ENSEMBLE=false
ENSEMBLE_PRIOR_STRENGTH=4
ENSEMBLE_HALF_LIFE_TRADES=25
ENSEMBLE_MIN_TRADES=3

# --- Risk limits -----------------------------------------------------------
MAX_POSITION_JPY=500000
MAX_ORDER_JPY=300000
MAX_DAILY_LOSS_JPY=30000
MAX_MARKET_DATA_AGE_SECONDS=600
RISK_DAY_TIMEZONE=Asia/Tokyo

# --- Trading safety switches (all must be flipped for live trading) --------
ENABLE_AUTOMATIC_TRADING=false
LIVE_TRADING_ACKNOWLEDGED=false
TRADING_KILL_SWITCH=false

# --- API / dashboard -------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://api:8000
DASHBOARD_PORT=8501
DASHBOARD_REFRESH_SECONDS=300
DASHBOARD_TIMEZONE=Asia/Tokyo

# --- Scheduler -------------------------------------------------------------
RUN_SCHEDULER_IN_API=false        # true = single-container deployment
PORTFOLIO_SNAPSHOT_INTERVAL_SECONDS=900
